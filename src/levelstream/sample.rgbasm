include "utils.rgbinc"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constants
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

def LEVEL_MOVE_MAX                  equ 8
def LEVEL_MAX_X                     equ 1600

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; WRAM variables
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

rsset _RAM

; Input state
def WRAM_INPUT                      rb sizeof_INPUT

; Position inside the level
def WRAM_POSITION_X                 rb 2
def WRAM_PREVIOUS_POSITION_X        rb 2
def WRAM_MOVE_X                     rb 1

; column copy request
def WRAM_COLUMN_COPY_SOURCE         rb 2
def WRAM_COLUMN_COPY_DESTINATION    rb 2

def WRAM_END                        rb 0

def WRAM_SIZE                       equ (WRAM_END - _RAM)

; Sanity check
println "WRAM usage: {d:WRAM_SIZE} bytes"
assert WRAM_SIZE <= $2000, "Too many bytes used in WRAM"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Graphics data
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "graphics_data", rom0

; Tileset
chr_data:
incbin "level.chr"
chr_data_end:
assert chr_data_end - chr_data < 4 * 1024, "Too many tiles in tileset (maximum 256 tiles)"

; Tilemap columns
idx_data:
incbin "level.idx"
idx_data_end:

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Interrupts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "vblank_interrupt", rom0[$0040]
    reti

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Sample code
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

section "sample", rom0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Copy 18 indices from a source address in rom to a destination address in vram
; de = source address in the rom
; hl = destination address in the tilemap
CopyColumn:
    ld bc, SCRN_VX_B
    rept SCRN_Y_B
        ld a, [de]
        inc de
        ld [hl], a
        add hl, bc
    endr
    ret

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Initialization
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

InitSample::
    ; Set the palettes
    ld a, %00011011
    ld [rBGP], a
    ld [rOBP0], a
    ld [rOBP1], a

    ; Clear the oam and wram
    ClearMemory _OAMRAM, OAM_COUNT * sizeof_OAM_ATTRS
    ClearMemory _RAM, WRAM_SIZE

    ; Input initialization
    InputInitialize WRAM_INPUT

    ; Initialize non-zero variables
    ld a, 1
    ld [WRAM_MOVE_X], a

    ; Copy the tileset to vram
    CopyMemory chr_data, _VRAM + 2 * 1024, chr_data_end - chr_data

    ; Copy the starting columns to vram
    def TILEMAP_OFFSET = 0
    def ROM_OFFSET = 0
    rept SCRN_X_B
        ld hl, _SCRN0 + TILEMAP_OFFSET
        ld de, idx_data + ROM_OFFSET
        call CopyColumn
        def TILEMAP_OFFSET += SCRN_VX_B
        def ROM_OFFSET += SCRN_Y_B
    endr

    ; Enable the vblank and lcd interrupts
    ld a, IEF_VBLANK
    ld [rIE], a
    ei

    ; Set the graphics and enable the lcd
    ld a, LCDCF_ON | LCDCF_BGON | LCDCF_BG8800 | LCDCF_BG9800
    ld [rLCDC], a

    ret

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Update
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

UpdateSample::
    ; Save previous position
    ld a, [WRAM_POSITION_X + 0]
    ld [WRAM_PREVIOUS_POSITION_X + 0], a
    ld a, [WRAM_POSITION_X + 1]
    ld [WRAM_PREVIOUS_POSITION_X + 1], a

    ; Update the input
    InputUpdate WRAM_INPUT

    ; Update move speed, keeping it between in range [1-8]
    InputTestHeld WRAM_INPUT, PADF_UP
    jr nz, .up
        ld a, [WRAM_MOVE_X]
        inc a
        cp a, LEVEL_MOVE_MAX
        jr c, .pan_increase
            ld [WRAM_MOVE_X], a
        .pan_increase
    .up
    InputTestHeld WRAM_INPUT, PADF_DOWN
    jr nz, .down
        ld a, [WRAM_MOVE_X]
        dec a
        jr z, .pan_decrease
            ld [WRAM_MOVE_X], a
        .pan_decrease
    .down

    ; Update pan position
    InputTestHeld WRAM_INPUT, PADF_LEFT
    jr nz, .left
        ld a, [WRAM_MOVE_X]
        ld b, a
        ld a, [WRAM_POSITION_X + 0]
        sub a, b
        ld [WRAM_POSITION_X + 0], a
        ld a, [WRAM_POSITION_X + 1]
        sbc a, 0
        ld [WRAM_POSITION_X + 1], a
    .left
    InputTestHeld WRAM_INPUT, PADF_RIGHT
    jr nz, .right
        ld a, [WRAM_MOVE_X]
        ld b, a
        ld a, [WRAM_POSITION_X + 0]
        add a, b
        ld [WRAM_POSITION_X + 0], a
        ld a, [WRAM_POSITION_X + 1]
        adc a, 0
        ld [WRAM_POSITION_X + 1], a
    .right

    ; Clamp pan position if necessary
    Load16 hl, WRAM_POSITION_X
    bit 7, h
    jr z, .position_underflow
        ; Position is below zero, clamp to zero
        ld hl, 0
        Store16 WRAM_POSITION_X, hl
        jr .position_clamped
    .position_underflow
    ld a, high(LEVEL_MAX_X)
    cp a, h
    jr nc, .position_clamped
    jr nz, .position_overflow

    ld a, low(LEVEL_MAX_X)
    cp a, l
    jr nc, .position_clamped

    .position_overflow
        ; Position is beyond the right limit
        ld hl, LEVEL_MAX_X
        Store16 WRAM_POSITION_X, hl

    .position_clamped

    ; Determine if we must stream a column or not
    Load16 hl, WRAM_POSITION_X
    Load16 de, WRAM_PREVIOUS_POSITION_X
    ld a, l
    and a, $F8
    ld b, a
    Load16 de, WRAM_POSITION_X
    ld a, e
    and a, $F8
    cp a, b
    jr z, .stream_column
        ; Determine if we are streaming left or right
        ld a, l
        sub a, e
        ld l, a
        ld a, h
        sbc a, d
        ld h, a
        bit 7, h
        jr z, .stream_request_right
        .stream_request_left
            ; TODO stream right, compute the data source address and the data destination address
            jr .stream_request_done
        .stream_request_right
            ; TODO stream right, compute the data source address and the data destination address
        .stream_request_done
    .stream_column

    ; Wait for the vblank
    halt

    ; Check if there is any request (source is not $0000)
    Load16 de, WRAM_COLUMN_COPY_SOURCE
    ld a, d
    or a, e
    jr z, .column_request
        ; Copy the column
        Load16 hl, WRAM_COLUMN_COPY_DESTINATION
        call CopyColumn

        ; Clear the request
        ld de, $0000
        Store16 WRAM_COLUMN_COPY_SOURCE, de
    .column_request

    ; Set horizontal scrolling
    ld a, [WRAM_POSITION_X + 0]
    ld [rSCX], a

    ret

